# Copy to env/.env.dev (or env/.env.<ENVIRONMENT>) and fill in real values.
# Select the file with: ENVIRONMENT=staging npx playwright test

# Frontend application URL
APP_URL=https://practicesoftwaretesting.com

# Backend API URL
API_URL=https://api.practicesoftwaretesting.com

# Customer account used by the auth setup
APP_EMAIL=customer@practicesoftwaretesting.com
APP_PASSWORD=your-password
